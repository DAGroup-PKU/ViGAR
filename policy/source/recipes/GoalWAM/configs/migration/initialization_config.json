        "action2llm": 5.0,
        "action_modality_embed": 5.0,
        "llm2action": 5.0
      },
      "model": null,
      "optimizer_type": "FusedAdam",
      "weight_decay": 0.05
    },
    "scheduler": {
      "_target_": "cosmos_framework.utils.vfm.optimizer.build_lr_scheduler",
