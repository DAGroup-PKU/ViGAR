      ],
      "f_max": [
        0.4
      ],
      "f_min": [
        0.0
      ],
      "f_start": [
        0.0
      ],
      "lr_scheduler_type": "LambdaLinear",
      "optimizer": null,
      "verbosity_interval": 0,
      "warm_up_steps": [
        0
      ]
    },
    "trainer": {
      "callbacks": {
        "goal_conditioning_health": {
          "_target_": "cosmos_framework.callbacks.goal_conditioning_health.GoalConditioningHealthCheck",
