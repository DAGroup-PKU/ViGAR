            "config": {
              "_target_": "cosmos_framework.configs.base.defaults.vlm.create_vlm_config",
              "base_config": {
                "_target_": "cosmos_framework.model.vfm.mot.unified_mot.Qwen3VLMoTConfig.from_json_file",
