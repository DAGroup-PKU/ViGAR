# Copy to .env. Set absolute paths to your existing assets and environments.
# Policy/I2I use Python 3.13 + the pinned CUDA runtime; simulator has a separate environment.
PYTHON_BIN=/path/to/cosmos-env/bin/python
NATIVE_SIM_PYTHON=/path/to/robotwin-env/bin/python
GOALWAM_WORKSPACE=/path/to/new-goalwam-workspace
BASE_CHECKPOINT_PATH=/path/to/Cosmos3-Nano-dcp
WAN_VAE_PATH=/path/to/Wan2.2_VAE.pth
QWEN_TOKENIZER_PATH=/path/to/text_tokenizer

# Selected policy: robotwin_c2r 50k; selected planner: ROI 70k regular.
GOALWAM_POLICY_CHECKPOINT=/path/to/vigar-weights/robotwin_c2r/iter_000050000
GOALWAM_I2I_CHECKPOINT=/path/to/vigar-weights/i2i/roi/iter_000070000
GOALWAM_DATASET_MANIFEST=/path/to/dataset49_manifest.json
GOALWAM_GENERATED_GOAL_CACHE=/path/to/final2500_repair3/cache
GOALWAM_POLICY_WORKSPACE=/path/to/new-goalwam-workspace/policy
POLICY8_PARQUET_CACHE=/path/to/new-goalwam-workspace/parquet-cache

# I2I training assets. The 2500-episode action dataset is not the I2I random500 pool.
GOALWAM_I2I_ASSET_ROOT=/path/to/i2i-assets
GOALWAM_I2I_NORMAL30K=/path/to/original_i2i/checkpoints/iter_000030000
GOALWAM_I2I_ROI40K=/path/to/roi40k/checkpoints/iter_000040000
GOALWAM_I2I_NORMAL_DATASET=/path/to/robotwin_fixedgoal_declared_lerobot
GOALWAM_I2I_ROI40_WORK=/path/to/ee_window_v1
GOALWAM_I2I_ROI40_DATASET=/path/to/dataset_index_random_completed
GOALWAM_I2I_RANDOM500_WORK=/path/to/random500_all50
GOALWAM_I2I_RANDOM500_DATASET=/path/to/random500_all50/dataset_index
GOALWAM_I2I_METADATA_ROOT=/path/to/original_metadata_root

# Existing RoboTwin runtime, with matching assets installed. Bundled source is simulation/RoboTwin.
ROBOTWIN_ROOT=/path/to/RoboTwin
WANDB_ENTITY=your-wandb-entity
WANDB_PROJECT=robotwin_clean2rand
WANDB_MODE=online
# Authenticate W&B through your existing environment or credential store.
# Optional offline goal curation uses GOALWAM_VLM_BASE_URL and GOALWAM_VLM_API_KEY.
