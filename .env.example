# Copy to .env. Set absolute paths to your existing assets and environments.
# Policy/subgoal planner use Python 3.13 + the pinned CUDA runtime; simulator has a separate environment.
PYTHON_BIN=/path/to/ViGAR/.venv-model/bin/python
NATIVE_SIM_PYTHON=/path/to/robotwin-workspace/.venv/bin/python
VIGAR_WORKSPACE=/path/to/new-vigar-workspace
BASE_CHECKPOINT_PATH=/path/to/vigar/weights/Cosmos3-Nano-dcp
WAN_VAE_PATH=/path/to/vigar/weights/policy/robotwin_c2r/vae/Wan2.2_VAE.pth
QWEN_TOKENIZER_PATH=/path/to/vigar/weights/policy/robotwin_c2r/text_tokenizer

VIGAR_POLICY_CHECKPOINT=/path/to/vigar/weights/policy/robotwin_c2r
SUBGOAL_PLANNER_CHECKPOINT=/path/to/vigar/weights/subgoal_planner/robotwin_subgoal_planner
VIGAR_DATASET_MANIFEST=/path/to/vigar/data/robotwin_segmented_2500/dataset.json
VIGAR_GENERATED_GOAL_CACHE=/path/to/vigar/data/robotwin_segmented_2500/goal_cache
VIGAR_REAL_ROBOT_DATASET=/path/to/vigar/data/real_robot_900hr
VIGAR_POLICY_WORKSPACE=/path/to/new-vigar-workspace/policy
VIGAR_PARQUET_CACHE=/path/to/new-vigar-workspace/parquet-cache

VIGAR_ROOT=/path/to/ViGAR
VIGAR_SOURCE_DATASET=/path/to/original_lerobot_dataset
VIGAR_RAW_TRAJECTORIES=/path/to/raw_by_task
VIGAR_STAGE_BOUNDARIES=/path/to/stage_boundaries.jsonl
VIGAR_ANNOTATED_DATASET=/path/to/new_annotated_dataset
VIGAR_DATASET49_WORK=/path/to/new_action_conversion
VIGAR_GOAL_GENERATION_WORK=/path/to/new_goal_generation

ROBOTWIN_ROOT=/path/to/robotwin-workspace/RoboTwin
WANDB_ENTITY=your-wandb-entity
WANDB_PROJECT=vigar
WANDB_MODE=offline
